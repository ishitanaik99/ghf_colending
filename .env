# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV ENVIRONMENT — personal laptop
# Copy this file, fill in real values, never commit to git
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── App ──────────────────────────────────────────────────────────────────────
PORT=4113

# ── Database (local PostgreSQL) ───────────────────────────────────────────────
# Change these to match your local Postgres setup
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mydatabase
DB_USERNAME=admin
DB_PASSWORD=admin
DB_SCHEMA=public

# ── JWT ───────────────────────────────────────────────────────────────────────
# Any long random string works for local dev
JWT_SECRET=local-dev-secret-change-in-production-minimum-32-chars
JWT_ACCESS_EXPIRY=900000      # 15 min in ms
JWT_REFRESH_EXPIRY=604800000  # 7 days in ms

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=30
OTP_MAX_ATTEMPTS=5

# ── Email route (leave blank for local dev — OTP will be logged to console) ──
# On work laptop these point to the internal email microservice
# Locally: leave EMAIL_OTP_URL empty → OtpService skips HTTP call, logs OTP
EMAIL_OTP_URL=
EMAIL_OTP_SUBJECT=Your OTP for LendSphere Login

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
